@model CivicFix.Models.ReportDashboardViewModel

@{
    ViewData["Title"] = "Gestión de reportes";
    ViewData["ReportCount"] = Model.TotalCount;
    var culture = new System.Globalization.CultureInfo("es-MX");
    var todayLabel = DateTime.Today.ToString("dddd, dd MMM yyyy", culture);
    var resolvedPercent = Model.TotalCount == 0 ? 0 : (int)Math.Round(Model.ResolvedCount * 100d / Model.TotalCount);
    var pendingPercent = Model.TotalCount == 0 ? 0 : (int)Math.Round(Model.PendingCount * 100d / Model.TotalCount);
    var inProgressPercent = Model.TotalCount == 0 ? 0 : (int)Math.Round(Model.InProgressCount * 100d / Model.TotalCount);
    var activeFilters = new { categoria = Model.SelectedCategory, busqueda = Model.SearchTerm };
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Operación diaria <span class="eyebrow-dot"></span> Zona Metropolitana</p>
        <h1>Gestión de reportes</h1>
        <p class="heading-date">@todayLabel <span>·</span> Seguimiento ciudadano</p>
    </div>
    <div class="heading-note"><span class="live-indicator"></span> Actualizado al momento</div>
</section>

<section class="metrics-grid" aria-label="Resumen de reportes">
    <article class="metric-card metric-card--blue">
        <div class="metric-top"><span class="metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M7 9h10M7 13h7"/></svg></span><span class="metric-trend">Últimos 30 días</span></div>
        <strong class="metric-value">@Model.TotalCount</strong>
        <span class="metric-label">Total de reportes</span>
        <div class="metric-track"><span style="width:100%"></span></div>
    </article>
    <article class="metric-card metric-card--green">
        <div class="metric-top"><span class="metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.7 2.7L16.5 9"/></svg></span><span class="metric-trend">@resolvedPercent% del total</span></div>
        <strong class="metric-value">@Model.ResolvedCount</strong>
        <span class="metric-label">Resueltos</span>
        <div class="metric-track"><span style="width:@(resolvedPercent)%"></span></div>
    </article>
    <article class="metric-card metric-card--orange">
        <div class="metric-top"><span class="metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v6M12 16.5v.1"/></svg></span><span class="metric-trend">Requieren atención</span></div>
        <strong class="metric-value">@Model.PendingCount</strong>
        <span class="metric-label">Pendientes</span>
        <div class="metric-track"><span style="width:@(pendingPercent)%"></span></div>
    </article>
    <article class="metric-card metric-card--sky">
        <div class="metric-top"><span class="metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg></span><span class="metric-trend">Cuadrillas activas</span></div>
        <strong class="metric-value">@Model.InProgressCount</strong>
        <span class="metric-label">En proceso</span>
        <div class="metric-track"><span style="width:@(inProgressPercent)%"></span></div>
    </article>
</section>

<section class="reports-panel" aria-labelledby="reports-title">
    <div class="panel-heading">
        <div class="panel-title-block">
            <div class="panel-title-row"><h2 id="reports-title">Reportes ciudadanos</h2><span class="result-count">@Model.Reports.Count</span></div>
            <p>Folios recientes y seguimiento operativo</p>
        </div>
        <div class="panel-tools">
            <a class="button button--quiet" asp-controller="Home" asp-action="Export" asp-route-estado="@Model.SelectedStatus" asp-route-categoria="@Model.SelectedCategory" asp-route-busqueda="@Model.SearchTerm">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 17v3h14v-3"/></svg>
                Exportar CSV
            </a>
        </div>
    </div>

    <nav class="status-tabs" aria-label="Filtrar por estatus">
        <a class="status-tab @(string.IsNullOrEmpty(Model.SelectedStatus) ? "is-selected" : "")" asp-action="Index" asp-route-estado="" asp-route-categoria="@Model.SelectedCategory" asp-route-busqueda="@Model.SearchTerm">Todos <span>@Model.TotalCount</span></a>
        <a class="status-tab @(Model.SelectedStatus == "Pendiente" ? "is-selected" : "")" asp-action="Index" asp-route-estado="Pendiente" asp-route-categoria="@Model.SelectedCategory" asp-route-busqueda="@Model.SearchTerm">Pendiente</a>
        <a class="status-tab @(Model.SelectedStatus == "En Proceso" ? "is-selected" : "")" asp-action="Index" asp-route-estado="En Proceso" asp-route-categoria="@Model.SelectedCategory" asp-route-busqueda="@Model.SearchTerm">En proceso</a>
        <a class="status-tab @(Model.SelectedStatus == "Resuelto" ? "is-selected" : "")" asp-action="Index" asp-route-estado="Resuelto" asp-route-categoria="@Model.SelectedCategory" asp-route-busqueda="@Model.SearchTerm">Resuelto</a>
        <a class="status-tab @(Model.SelectedStatus == "Cancelado" ? "is-selected" : "")" asp-action="Index" asp-route-estado="Cancelado" asp-route-categoria="@Model.SelectedCategory" asp-route-busqueda="@Model.SearchTerm">Cancelado</a>
    </nav>

    <form class="filter-bar" asp-controller="Home" asp-action="Index" method="get">
        <input type="hidden" name="estado" value="@Model.SelectedStatus" />
        <label class="filter-search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
            <input type="search" name="busqueda" value="@Model.SearchTerm" placeholder="Buscar en reportes" aria-label="Buscar en reportes" />
        </label>
        <label class="select-wrap">
            <span class="sr-only">Categoría</span>
            <select name="categoria" aria-label="Filtrar por categoría">
                <option value="">Todas las categorías</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category" selected="@(Model.SelectedCategory == category)">@category</option>
                }
            </select>
        </label>
        <button class="button button--filter" type="submit">Aplicar filtros</button>
    </form>

    <div class="table-wrap">
        <table class="report-table">
            <thead>
                <tr>
                    <th scope="col">Folio</th>
                    <th scope="col">Categoría</th>
                    <th scope="col">Ubicación</th>
                    <th scope="col">Prioridad</th>
                    <th scope="col">Fecha</th>
                    <th scope="col">Estatus</th>
                    <th scope="col">Cuadrilla</th>
                    <th scope="col"><span class="sr-only">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Reports.Count == 0)
                {
                    <tr><td colspan="8" class="empty-state">No hay reportes que coincidan con estos filtros.</td></tr>
                }
                @foreach (var report in Model.Reports)
                {
                    <tr>
                        <td><span class="folio">@report.Folio</span></td>
                        <td><span class="category-tag category-tag--@report.Category.ToLowerInvariant()">@report.Category</span></td>
                        <td><span class="location-text">@report.Location</span></td>
                        <td><span class="priority priority--@report.Priority.ToLowerInvariant()"><i></i>@report.Priority</span></td>
                        <td class="date-cell">@report.CreatedAt.ToString("dd MMM yyyy", culture)</td>
                        <td><span class="status-pill status-pill--@report.Status.ToLowerInvariant().Replace(" ", "-")"><i></i>@report.Status</span></td>
                        <td class="crew-cell">@(report.Crew ?? "—")</td>
                        <td class="action-cell">
                            @if (report.Status == "Pendiente")
                            {
                                <form asp-action="Assign" method="post">
                                    <input type="hidden" name="id" value="@report.Id" />
                                    <input type="hidden" name="busqueda" value="@Model.SearchTerm" />
                                    <input type="hidden" name="estado" value="@Model.SelectedStatus" />
                                    <input type="hidden" name="categoria" value="@Model.SelectedCategory" />
                                    <button class="row-action row-action--assign" type="submit">Asignar</button>
                                </form>
                            }
                            else if (report.Status == "En Proceso")
                            {
                                <form asp-action="Resolve" method="post">
                                    <input type="hidden" name="id" value="@report.Id" />
                                    <input type="hidden" name="busqueda" value="@Model.SearchTerm" />
                                    <input type="hidden" name="estado" value="@Model.SelectedStatus" />
                                    <input type="hidden" name="categoria" value="@Model.SelectedCategory" />
                                    <button class="row-action row-action--resolve" type="submit">Resolver</button>
                                </form>
                            }
                            else
                            {
                                <span class="action-done" aria-label="Sin acciones disponibles">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="table-caption"><span>Mostrando <strong>@Model.Reports.Count</strong> de <strong>@Model.TotalCount</strong> reportes</span><span>Datos de operación ciudadana</span></div>
</section>