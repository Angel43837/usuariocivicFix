<!DOCTYPE html>
<html lang="es-MX">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f2748" />
    <title>@ViewData["Title"] · CivicFix</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="citizen-body">
    <div class="citizen-shell">
        <div class="citizen-topbar">Ayuntamiento de Maravatío, Michoacán · Atención Ciudadana</div>
        <header class="citizen-header">
            <a class="citizen-brand" asp-controller="Reports" asp-action="Create">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 40 40" fill="none"><path d="M20 3 34 9v10c0 9-5.7 14.6-14 18C11.7 33.6 6 28 6 19V9l14-6Z" stroke="currentColor" stroke-width="2"/><path d="m13 20 4.5 4.5L27 15" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="20" cy="13" r="2" fill="currentColor"/></svg>
                </span>
                <span class="citizen-brand-copy"><strong>CivicFix</strong><small>PORTAL CIUDADANO</small></span>
            </a>

            <nav class="citizen-nav" aria-label="Navegación ciudadana">
                <a asp-controller="Reports" asp-action="Create">Nuevo reporte</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Reports" asp-action="Mine">Mis reportes</a>
                }
            </nav>

            <div class="citizen-auth">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var displayName = User.FindFirst("DisplayName")?.Value ?? User.Identity!.Name;
                    <span class="citizen-user">Hola, @displayName</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="button button--quiet" type="submit">Salir</button>
                    </form>
                }
                else
                {
                    <a class="button button--quiet" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                    <a class="button button--primary" asp-controller="Account" asp-action="Register">Registrarme</a>
                }
            </div>
        </header>

        <main class="citizen-main" role="main">
            @RenderBody()
        </main>

        <footer class="citizen-footer">
            <span>CivicFix · Dirección de Obras Públicas, Maravatío</span>
            <span>Portal ciudadano de reportes urbanos</span>
        </footer>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
