@model CivicFix.Models.CreateReportViewModel

@{
    ViewData["Title"] = "Nuevo reporte";
}

<section class="page-heading page-heading--form">
    <div>
        <p class="eyebrow">Atención ciudadana <span class="eyebrow-dot"></span> Nuevo folio</p>
        <h1>Reportar un problema</h1>
        <p class="heading-date">Describe el servicio urbano que necesita atención.</p>
    </div>
    <a class="button button--quiet" asp-controller="Home" asp-action="Index">Volver al panel</a>
</section>

<section class="form-panel">
    <div class="form-panel-heading">
        <span class="form-step">01</span>
        <div><h2>Detalles del reporte</h2><p>Los campos marcados son necesarios para dar seguimiento.</p></div>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="report-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-grid">
            <div class="field field--wide">
                <label asp-for="CitizenName"></label>
                <input asp-for="CitizenName" autocomplete="name" placeholder="Nombre de quien reporta" />
                <span asp-validation-for="CitizenName" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Category"></label>
                <select asp-for="Category">
                    <option value="">Selecciona una categoría</option>
                    @foreach (var category in (string[])ViewBag.Categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
                <span asp-validation-for="Category" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Priority"></label>
                <select asp-for="Priority">
                    @foreach (var priority in (string[])ViewBag.Priorities)
                    {
                        <option value="@priority">@priority</option>
                    }
                </select>
                <span asp-validation-for="Priority" class="field-error"></span>
            </div>
            <div class="field field--wide">
                <label asp-for="Location"></label>
                <div class="location-input-row">
                    <input asp-for="Location" autocomplete="street-address" placeholder="Calle, número, colonia o referencia" />
                    <button class="button button--quiet location-button" id="get-location" type="button" title="Usar mi ubicación">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                        <span>Mi ubicación</span>
                    </button>
                </div>
                <input asp-for="Latitude" type="hidden" />
                <input asp-for="Longitude" type="hidden" />
                <div class="map-picker" id="report-map" role="application" aria-label="Mapa para seleccionar la ubicación del reporte"></div>
                <span asp-validation-for="Location" class="field-error"></span>
                <span class="field-hint" id="location-feedback">Puedes escribir una dirección, elegir un punto en el mapa o compartir tu ubicación actual.</span>
                <span class="map-attribution" id="map-feedback"></span>
            </div>
            <div class="field field--wide">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" rows="5" placeholder="¿Qué ocurre? ¿Desde cuándo? Agrega detalles que ayuden a localizar el problema."></textarea>
                <span asp-validation-for="Description" class="field-error"></span>
            </div>
            <div class="field field--wide">
                <label asp-for="Photo"></label>
                <div class="upload-control">
                    <input asp-for="Photo" type="file" accept="image/jpeg,image/png,image/webp" />
                    <span class="field-hint">JPG, PNG o WEBP · máximo 5 MB</span>
                    <span asp-validation-for="Photo" class="field-error"></span>
                    <img id="photo-preview" class="photo-preview" alt="Vista previa de la fotografía" hidden />
                </div>
            </div>
        </div>
        <div class="form-actions">
            <a class="button button--quiet" asp-controller="Home" asp-action="Index">Cancelar</a>
            <button class="button button--primary" type="submit">Enviar reporte <span aria-hidden="true">→</span></button>
        </div>
    </form>
</section>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
}