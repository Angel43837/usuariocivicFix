@model IReadOnlyList<CivicFix.Models.CivicReport>

@{
    ViewData["Title"] = "Mis reportes";
    Layout = "_CitizenLayout";
    var culture = new System.Globalization.CultureInfo("es-MX");
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Mi cuenta <span class="eyebrow-dot"></span> Seguimiento personal</p>
        <h1>Mis reportes</h1>
        <p class="heading-date">Folios que registraste con tu cuenta.</p>
    </div>
    <a class="button button--primary top-create" asp-controller="Reports" asp-action="Create">
        <span aria-hidden="true">+</span><span>Nuevo reporte</span>
    </a>
</section>

<section class="reports-panel" aria-labelledby="mine-title">
    <div class="panel-heading">
        <div class="panel-title-block">
            <div class="panel-title-row"><h2 id="mine-title">Tus folios</h2><span class="result-count">@Model.Count</span></div>
            <p>Estado actual de cada reporte que enviaste</p>
        </div>
    </div>

    <div class="table-wrap">
        <table class="report-table">
            <thead>
                <tr>
                    <th scope="col">Folio</th>
                    <th scope="col">Categoría</th>
                    <th scope="col">Ubicación</th>
                    <th scope="col">Prioridad</th>
                    <th scope="col">Fecha</th>
                    <th scope="col">Estatus</th>
                    <th scope="col">Cuadrilla</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="empty-state">Todavía no tienes reportes registrados.</td></tr>
                }
                @foreach (var report in Model)
                {
                    <tr>
                        <td><span class="folio">@report.Folio</span></td>
                        <td><span class="category-tag category-tag--@report.Category.ToLowerInvariant()">@report.Category</span></td>
                        <td><span class="location-text">@report.Location</span></td>
                        <td><span class="priority priority--@report.Priority.ToLowerInvariant()"><i></i>@report.Priority</span></td>
                        <td class="date-cell">@report.CreatedAt.ToString("dd MMM yyyy", culture)</td>
                        <td><span class="status-pill status-pill--@report.Status.ToLowerInvariant().Replace(" ", "-")"><i></i>@report.Status</span></td>
                        <td class="crew-cell">@(report.Crew ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="table-caption"><span>Mostrando <strong>@Model.Count</strong> reportes propios</span><span>Datos de tu cuenta</span></div>
</section>
