@model string

@{
    ViewData["Title"] = "Reporte recibido";
    Layout = "_CitizenLayout";
}

<section class="confirmation-panel">
    <span class="confirmation-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="m5 12 4.5 4.5L19 7"/></svg>
    </span>
    <p class="eyebrow">Atención ciudadana</p>
    <h1>Reporte recibido</h1>
    <p>Tu folio quedó registrado y está pendiente de revisión.</p>
    <div class="confirmation-folio"><span>Folio de seguimiento</span><strong>@Model</strong></div>
    <a class="button button--primary" asp-controller="Reports" asp-action="Mine">Ver mis reportes</a>
</section>