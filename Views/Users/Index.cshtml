@model IReadOnlyList<CivicFix.Models.UserSummaryViewModel>

@{
    ViewData["Title"] = "Usuarios";
    var culture = new System.Globalization.CultureInfo("es-MX");
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Administración <span class="eyebrow-dot"></span> Cuentas registradas</p>
        <h1>Usuarios</h1>
        <p class="heading-date">Ciudadanos con cuenta en CivicFix.</p>
    </div>
</section>

<section class="reports-panel" aria-labelledby="users-title">
    <div class="panel-heading">
        <div class="panel-title-block">
            <div class="panel-title-row"><h2 id="users-title">Cuentas registradas</h2><span class="result-count">@Model.Count</span></div>
            <p>Nombre, correo y actividad de cada persona registrada</p>
        </div>
    </div>

    <div class="table-wrap">
        <table class="report-table">
            <thead>
                <tr>
                    <th scope="col">Nombre</th>
                    <th scope="col">Correo</th>
                    <th scope="col">Registrado</th>
                    <th scope="col">Reportes enviados</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4" class="empty-state">Todavía no hay usuarios registrados.</td></tr>
                }
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.DisplayName</td>
                        <td class="crew-cell">@user.Email</td>
                        <td class="date-cell">@user.CreatedAt.ToString("dd MMM yyyy", culture)</td>
                        <td><span class="result-count">@user.ReportCount</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="table-caption"><span>Mostrando <strong>@Model.Count</strong> usuarios</span><span>Datos de cuentas CivicFix</span></div>
</section>
