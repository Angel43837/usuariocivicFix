@model CivicFix.Models.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_CitizenLayout";
}

<section class="page-heading page-heading--form">
    <div>
        <p class="eyebrow">Mi cuenta <span class="eyebrow-dot"></span> Acceso</p>
        <h1>Inicia sesión</h1>
        <p class="heading-date">Entra para ver y crear tus reportes.</p>
    </div>
</section>

<section class="form-panel">
    <div class="form-panel-heading">
        <span class="form-step">01</span>
        <div><h2>Correo y contraseña</h2><p>Usa los datos con los que te registraste.</p></div>
    </div>

    <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="report-form">
        <div asp-validation-summary="All" class="validation-summary"></div>
        <div class="form-grid">
            <div class="field field--wide">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" autocomplete="email" placeholder="tu@correo.com" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <div class="field field--wide">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="current-password" placeholder="Tu contraseña" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
        </div>
        <div class="form-actions">
            <a class="button button--quiet" asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]">Crear cuenta</a>
            <button class="button button--primary" type="submit">Entrar <span aria-hidden="true">→</span></button>
        </div>
    </form>
</section>
